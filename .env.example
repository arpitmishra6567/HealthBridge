# HealthBridge
# ====================================================
# HealthBridge Environment Configuration Template
# Copy this file to .env.local and add your API keys.
# ====================================================

# Google AI Studio Gemini API Key (for 2-Way AI Health Navigator)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_google_ai_studio_api_key_here"

# Next.js Public Site URL (optional for production deployments)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contact Us Form Email Delivery via Resend (Optional for production email dispatch)
# Sign up at https://resend.com to obtain a free API key.
# When not set, contact submissions are safely validated, recorded in server logs,
# and inform the client of development/academic mode.
RESEND_API_KEY=""
CONTACT_RECEIVER_EMAIL="arpitmishra6567@gmail.com"
CONTACT_FROM_EMAIL="HealthBridge Contact <onboarding@resend.dev>"
